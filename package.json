{
  "name": "@siderolabs/talos-design-system",
  "version": "0.7.0",
  "description": "Design tokens and lint guardrails shared by every Talos product interface and the documentation site.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siderolabs/talos-design-system.git"
  },
  "type": "module",
  "bin": {
    "talos-audit": "./bin/talos-audit.mjs",
    "talos-migrate-spacing": "./bin/migrate-spacing.mjs"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "audit",
    "bin",
    "dist",
    "fonts",
    "lint",
    "tokens",
    "docs"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.scss": "./dist/tokens.scss",
    "./tailwind.css": "./dist/tailwind.css",
    "./tailwind-colour.css": "./dist/tailwind-colour.css",
    "./tailwind-spacing.css": "./dist/tailwind-spacing.css",
    "./fonts.css": "./dist/fonts.css",
    "./type.css": "./dist/type.css",
    "./mintlify.css": "./dist/mintlify.css",
    "./fonts/*": "./fonts/*",
    "./tokens.json": "./dist/tokens.json",
    "./eslint": "./lint/eslint/index.js",
    "./stylelint": "./lint/stylelint.js",
    "./audit": "./audit/page-audit.js"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "contrast": "node build/contrast.mjs",
    "fonts": "node build/fetch-fonts.mjs",
    "check": "npm run build && npm run contrast",
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "playwright": ">=1.40",
    "stylelint": ">=16"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "playwright": "^1.63.0",
    "stylelint": "^17.16.0",
    "typescript": "^7.0.2",
    "vue-eslint-parser": "^10.4.1"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "talos",
    "sidero"
  ],
  "publishConfig": {
    "access": "public"
  }
}
